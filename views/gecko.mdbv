// Views for Gecko types: arrays, strings, atoms, nsID, hash tables and smart pointers.
//
// Load it from the debug console with loadViews("<path>/views/gecko.mdbv"), list it under "views" in the launch
// configuration, or symlink it into ~/.config/mdb/views to load it at startup.
//
// The layouts are those of mozilla-central as of October 2026. Type names are matched in mdb's normalized form
// (no spaces except between words), which is also what mdb rebuilds for Gecko's -gsimple-template-names builds.

// ---------------------------------------------------------------------------------------------------------------
// Arrays
// ---------------------------------------------------------------------------------------------------------------

// nsTArray, AutoTArray, CopyableTArray, FallibleTArray, ... all derive from nsTArray_Impl. The elements are stored
// right after the header mHdr points to; for an AutoTArray, that header is inline.
view nsTArray_Impl<.*> {
  using T = template_arg(0)
  summary "length={mHdr->mLength}"
  children array((T*)(mHdr + 1), mHdr->mLength)
}

// mfbt/Vector.h. mBegin points either to the heap or to the vector's inline storage.
view mozilla::Vector<.*> {
  summary "length={mLength} capacity={mTail.mCapacity}"
  children array(mBegin, mLength)
}

// mfbt/Span.h. A span with a fixed extent has no size member; the extent is its second template argument.
view mozilla::Span<.*> {
  summary "length={template_arg(1)}"
  children array(storage_.data_, template_arg(1))
}

// A dynamic extent is the largest size_t, and then the size is stored. Loaded later, so this one wins for those.
view mozilla::Span<.*,18446744073709551615> {
  summary "length={storage_.size_}"
  children array(storage_.data_, storage_.size_)
}

// ---------------------------------------------------------------------------------------------------------------
// Strings
// ---------------------------------------------------------------------------------------------------------------

// nsString, nsCString, nsAutoString, nsDependentCString, nsLiteralString, ... all derive from nsTStringRepr. The
// length is wrapped in an nsTStringLengthStorage.
view mozilla::detail::nsTStringRepr<.*> {
  summary text(mData, mLength.mLength)
  children none
}

// A static atom's characters are stored mStringOffset bytes before the atom; a dynamic atom's characters follow the
// header of its string buffer.
view nsAtom {
  fn chars() -> char16_t* {
    if (mIsStatic) return (char16_t*)((char*)this - ((nsStaticAtom*)this)->mStringOffset);
    return (char16_t*)(((nsDynamicAtom*)this)->mStringBuffer.mRawPtr + 1);
  }
  summary text(chars(), mLength)
  children none
}

// ---------------------------------------------------------------------------------------------------------------
// nsID
// ---------------------------------------------------------------------------------------------------------------

// Hex formatting always adds 0x and has no zero padding, so this isn't quite the canonical
// {xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx} form, and leading zeros of each group are dropped.
view nsID {
  summary "{{{m0,x}-{m1,x}-{m2,x}-{(m3[0] << 8) | m3[1],x}-{((u64)m3[2] << 40) | ((u64)m3[3] << 32) | ((u64)m3[4] << 24) | ((u64)m3[5] << 16) | ((u64)m3[6] << 8) | m3[7],x}}}"
}

// ---------------------------------------------------------------------------------------------------------------
// Smart pointers
// ---------------------------------------------------------------------------------------------------------------

// The summary is the address; expanding shows the object pointed to, with its own view.
view RefPtr<.*> {
  summary "{mRawPtr}"
  children {
    if (mRawPtr) yield *mRawPtr;
  }
}

view nsCOMPtr<.*> {
  summary "{mRawPtr}"
  children {
    if (mRawPtr) yield *mRawPtr;
  }
}

// ---------------------------------------------------------------------------------------------------------------
// Hash tables: nsTHashtable and everything built on it (nsTHashMap, nsTHashSet, nsRefPtrHashtable, ...)
// ---------------------------------------------------------------------------------------------------------------

// The table is a PLDHashTable. One allocation holds `capacity` hash numbers followed by `capacity` entries of
// mEntrySize bytes. The capacity is 1 << (32 - mHashShift). Hashes 0 and 1 mark free and removed slots. A table
// allocates its storage on the first insertion.
//
// This view shows the entries themselves. The views after it, which win because they are loaded later, name each
// child by its key for the common key classes. Each of them repeats the walk, because views can't share functions.
view nsTHashtable<.*> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      yield *(Entry*)(entries + i * mTable.mEntrySize);
    }
  }
}

// Maps (nsBaseHashtableET entries, the value is mData), by key class.

view nsTHashtable<nsBaseHashtableET<nsIntegralHashKey<.*>,.*>> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      auto e = (Entry*)(entries + i * mTable.mEntrySize);
      yield [e->mValue] e->mData;
    }
  }
}

view nsTHashtable<nsBaseHashtableET<nsPtrHashKey<.*>,.*>> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      auto e = (Entry*)(entries + i * mTable.mEntrySize);
      yield [e->mKey] e->mData;
    }
  }
}

view nsTHashtable<nsBaseHashtableET<nsRefPtrHashKey<.*>,.*>> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      auto e = (Entry*)(entries + i * mTable.mEntrySize);
      yield [e->mKey.mRawPtr] e->mData;
    }
  }
}

view nsTHashtable<nsBaseHashtableET<nsISupportsHashKey,.*>> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      auto e = (Entry*)(entries + i * mTable.mEntrySize);
      yield [e->mSupports.mRawPtr] e->mData;
    }
  }
}

// nsStringHashKey and nsCStringHashKey
view nsTHashtable<nsBaseHashtableET<nsC?StringHashKey,.*>> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      auto e = (Entry*)(entries + i * mTable.mEntrySize);
      yield [text(e->mStr.mData, e->mStr.mLength.mLength)] e->mData;
    }
  }
}

// nsDepCharHashKey and nsCharPtrHashKey: NUL-terminated char* keys
view nsTHashtable<nsBaseHashtableET<(nsDepCharHashKey|nsCharPtrHashKey),.*>> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      auto e = (Entry*)(entries + i * mTable.mEntrySize);
      yield [cstr(e->mKey)] e->mData;
    }
  }
}

// Atom keys: the characters are found as in the nsAtom view.
view nsTHashtable<nsBaseHashtableET<mozilla::AtomHashKey,.*>> {
  using Entry = template_arg(0)
  fn chars(nsAtom *atom) -> char16_t* {
    if (atom->mIsStatic) return (char16_t*)((char*)atom - ((nsStaticAtom*)atom)->mStringOffset);
    return (char16_t*)(((nsDynamicAtom*)atom)->mStringBuffer.mRawPtr + 1);
  }
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      auto e = (Entry*)(entries + i * mTable.mEntrySize);
      auto atom = e->mKey.mRawPtr;
      yield [text(chars(atom), atom->mLength)] e->mData;
    }
  }
}

// Sets (nsTHashSet, and nsTHashtable used directly): the entry is the key class itself, so show its key member,
// which is displayed with its own view (strings, RefPtr, ...).

view nsTHashtable<nsIntegralHashKey<.*>> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      yield ((Entry*)(entries + i * mTable.mEntrySize))->mValue;
    }
  }
}

// nsPtrHashKey, nsRefPtrHashKey, nsDepCharHashKey, nsCharPtrHashKey and mozilla::AtomHashKey all keep their key in
// mKey.
view nsTHashtable<(nsPtrHashKey<.*>|nsRefPtrHashKey<.*>|nsDepCharHashKey|nsCharPtrHashKey|mozilla::AtomHashKey)> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      yield ((Entry*)(entries + i * mTable.mEntrySize))->mKey;
    }
  }
}

view nsTHashtable<nsC?StringHashKey> {
  using Entry = template_arg(0)
  let store = mTable.mEntryStore.mEntryStore;
  let capacity = store ? (u32)1 << (32 - mTable.mHashShift) : (u32)0;
  summary "count={mTable.mEntryCount}"
  children {
    auto hashes = (u32*)store;
    auto entries = store + capacity * 4;
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] < 2) continue;
      yield ((Entry*)(entries + i * mTable.mEntrySize))->mStr;
    }
  }
}

// ---------------------------------------------------------------------------------------------------------------
// Hash tables: mfbt's mozilla::HashMap and mozilla::HashSet
// ---------------------------------------------------------------------------------------------------------------

// One allocation holds `capacity` hash numbers followed by `capacity` entries. The capacity is
// 1 << (32 - hashShift), and the hash shift is the low byte of mGenAndHashShift. Hashes 0 and 1 mark free and
// removed slots. The entry type is the first template argument of mImpl's type, mozilla::detail::HashTable.
view mozilla::HashMap<.*> {
  using Impl = typeof(mImpl)
  using Entry = template_arg(Impl, 0)           // mozilla::HashMapEntry<K, V>: key_ and value_
  let capacity = mImpl.mTable ? (u32)1 << (32 - (mImpl.mGenAndHashShift & 0xff)) : (u32)0;
  summary "count={mImpl.mEntryCount}"
  children {
    auto hashes = (u32*)mImpl.mTable;
    auto entries = (Entry*)(hashes + capacity);
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] <= 1) continue;
      yield entries[i];
    }
  }
}

// Maps with integer or pointer keys name each child by its key. Other keys would only format as their type name, so
// those maps use the view above and show the whole entry. Loaded later, so this one wins.
view "mozilla::HashMap<((unsigned )?(char|short|int|long|long long)|bool|[^,]*\*),.*>" {
  using Impl = typeof(mImpl)
  using Entry = template_arg(Impl, 0)
  let capacity = mImpl.mTable ? (u32)1 << (32 - (mImpl.mGenAndHashShift & 0xff)) : (u32)0;
  summary "count={mImpl.mEntryCount}"
  children {
    auto hashes = (u32*)mImpl.mTable;
    auto entries = (Entry*)(hashes + capacity);
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] <= 1) continue;
      yield [entries[i].key_] entries[i].value_;
    }
  }
}

view mozilla::HashSet<.*> {
  using Impl = typeof(mImpl)
  using Entry = template_arg(Impl, 0)
  let capacity = mImpl.mTable ? (u32)1 << (32 - (mImpl.mGenAndHashShift & 0xff)) : (u32)0;
  summary "count={mImpl.mEntryCount}"
  children {
    auto hashes = (u32*)mImpl.mTable;
    auto entries = (Entry*)(hashes + capacity);
    for (u32 i = 0; i < capacity; ++i) {
      if (hashes[i] <= 1) continue;
      yield entries[i];
    }
  }
}

// Views for MdbBitSet and MdbSetBits in test/containers.cpp, used by the computedChildren test in
// test/driver/views.js. Bits have no address, so both views yield computed values.

// One bool per bit, named [0], [1], ...
view MdbBitSet {
  summary "count={mCount}"
  children {
    for (u32 i = 0; i < mCount; ++i)
      yield (bool)((mWords[i / 64] >> (i % 64)) & 1);
  }
}

// Only the set bits, named by their index, with a derived value
view MdbSetBits {
  children {
    for (u32 i = 0; i < 128; ++i)
      if ((mBits.mWords[i / 64] >> (i % 64)) & 1)
        yield [i] (u32)(i * 2);
  }
}

// Used by the keyedChildren test in test/driver/views.js: child names that contain quotes.
view MdbTArray_Impl<Name> {
  summary "length={mHdr->mLength}"
  children {
    for (u32 i = 0; i < mHdr->mLength; ++i) {
      auto e = (Name*)(mHdr + 1) + i;
      yield [text(e->mStr, e->mLen)] *e;
    }
  }
}
